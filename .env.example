# Copy to .env (git-ignored) and adjust. Every value has the default shown here.
# MySQL of docker-compose.yml is published on host port 3323 (3306 + 17), not on the default 3306
CHAT_DB_PORT=3323
# Database used by the Java backend (matches docker-compose.yml)
CHAT_DB_URL=jdbc:mysql://localhost:3323/chat_app
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=chat_dev
# Ports: clients -> Rust server, Rust server -> Java backend
CHAT_SERVER_PORT=6969
CHAT_BACKEND_PORT=9090
